# ============================================================
# netsekurity.com — environment template
# Copy this file to `.env` and fill in real values.
# Never commit the actual `.env` (it contains secrets).
# ============================================================

# --- Server ---
PORT=8094
ENVIRONMENT=development            # development | production
ALLOWED_ORIGINS=https://netsekurity.com

# --- Database ---
DATABASE_PATH=./data/netsekurity.db

# --- Auth (Google OAuth + JWT) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://netsekurity.com/auth/google/callback

# JWT used to sign session cookies (long random string, e.g. openssl rand -hex 32)
JWT_SECRET=

# Email that receives the super-admin role
SUPER_ADMIN_EMAIL=hans@dalang.io

# --- Payments (Xendit) ---
# https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_KEY=
XENDIT_SUCCESS_URL=https://netsekurity.com/dashboard
XENDIT_FAILURE_URL=https://netsekurity.com/pricing
# Charge currency. Every price on the site is quoted in USD and the audience is
# international, so USD is the default and the only value that matches what the
# customer is shown. Setting anything else means they meet a converted amount for
# the first time on the Xendit payment page — /su shows a warning when that is
# the case.
XENDIT_CURRENCY=USD
# Conversion rate, in charge-currency units per USD. Used ONLY when
# XENDIT_CURRENCY is not USD; ignored otherwise.
XENDIT_USD_RATE=16500
# Invoice API origin. Leave unset in production (defaults to https://api.xendit.co);
# tests point it at a local stub so no live invoice is ever created.
# XENDIT_API_BASE_URL=https://api.xendit.co

# --- Partner API (Dalang platform) ---
# HMAC shared secret for api.dalang.io. Empty disables the partner endpoints
# (503 PARTNER_API_DISABLED) without affecting self-serve scans.
PARTNER_ID=dalang
PARTNER_SECRET=

# --- Scan Worker (bot) ---
# Shared secret that authenticates the scanning agent to the worker endpoints
# (/api/pentests/worker/claim and /api/pentests/worker/report).
# Generate with: openssl rand -hex 32
BOT_AUTH_TOKEN=

# Meta / Facebook Conversions API (server-side Purchase + Lead events).
# Leave empty to disable server-side events; the client-side pixel still runs.
META_CAPI_TOKEN=

# --- Error reporting (Sentry, Dalang "Mata") ---
# DSN is a public client key, not a secret. Default: this repo's netsekurity
# project on mata.dalang.io; set it empty to disable reporting. A repo-local
# .env beats real environment variables, so leave it unset to use the default.
# SENTRY_DSN=https://bd3ff6f325012d29eacd074457aba1ea@mata.dalang.io/8
# Release reported to Sentry (optional; usually the release tag).
# SENTRY_RELEASE=v2026.10.27.1

# --- Analytics (public pages only) ---
# The Meta Pixel only attributes ad traffic. Set ONE of these to record where
# organic and referral visitors come from. Both empty = no analytics tag.
# PLAUSIBLE_DOMAIN: e.g. netsekurity.com (privacy-friendly, no cookie banner)
PLAUSIBLE_DOMAIN=
# GA_MEASUREMENT_ID: e.g. G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# NOTE: with ENVIRONMENT=production the server refuses to start unless
# JWT_SECRET, BOT_AUTH_TOKEN and XENDIT_CALLBACK_KEY are all set.
